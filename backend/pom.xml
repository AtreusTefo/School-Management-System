<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot "parent" gives us sensible default versions for everything,
         so we don't have to pick version numbers for each dependency ourselves. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>tracker</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>assignment-tracker</name>
    <description>Assignment tracking system (layered Spring Boot backend)</description>

    <properties>
        <java.version>25</java.version>
    </properties>

    <dependencies>
        <!-- WEB: gives us @RestController, the embedded Tomcat server, JSON, etc. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- DATA JPA: gives us JpaRepository and database mapping (@Entity). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- VALIDATION: gives us @NotBlank etc. for validating request bodies. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- SECURITY: authentication, role-based authorisation, BCrypt hashing. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- SQL SERVER DRIVER: how Java talks to MSSQLSERVER01 over TCP.
             Note this is JDBC, not Entity Framework - EF is a .NET technology and
             cannot be used from Java. JPA/Hibernate fills the same role here, and
             is equally "code first": the schema comes from the @Entity classes. -->
        <dependency>
            <groupId>com.microsoft.sqlserver</groupId>
            <artifactId>mssql-jdbc</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- FLYWAY: versioned schema migrations. On a persistent database the
             schema must be changed deliberately and repeatably, never inferred by
             the ORM - see ddl-auto=validate in application.properties. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-sqlserver</artifactId>
        </dependency>

        <!-- OPENAPI (US-27): generates the API description from the controllers
             and serves an interactive UI at /swagger-ui.html.

             This is the Java equivalent of registering Swagger in an ASP.NET
             Program.cs. It reads the existing @RestController and @Valid
             annotations, so the description is derived from the code rather than
             maintained by hand - a hand-written contract drifts the moment
             somebody changes a signature and forgets.

             IT IS OFF UNLESS SWITCHED ON. See app.openapi.enabled in
             application.properties: exposing an unauthenticated description of
             every endpoint is a development convenience, not something to ship. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.8.6</version>
        </dependency>

        <!-- H2: no longer the application database. Kept for TESTS only, so the
             suite runs fast and needs no SQL Server instance to be up. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- TEST: JUnit 5, Mockito, MockMvc, AssertJ. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Lets us run the app with:  mvn spring-boot:run -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- Surefire runs the tests in a JVM it forks itself, so the flags in
                 .mvn/jvm.config do not reach them - those apply to Maven's own JVM
                 and silence a different pair of warnings.

                 Mockito creates its mocks by attaching the Byte Buddy agent to the
                 already-running JVM. Java warns about that in four lines on every
                 test run, and says plainly that "dynamic loading of agents will be
                 disallowed by default in a future release".

                 The flag is already ON by default here - `java -XX:+PrintFlagsFinal
                 -version` reports EnableDynamicAgentLoading = true - so this changes
                 no behaviour at all. Stating it explicitly is what suppresses the
                 warning, and it records the decision: when a future JDK flips that
                 default, this line is the one to revisit, rather than discovering
                 the whole suite has gone red. It is the option Mockito documents. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-XX:+EnableDynamicAgentLoading</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>




