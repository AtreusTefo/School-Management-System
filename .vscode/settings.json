{
    "java.compile.nullAnalysis.mode": "automatic",

    // Analyse the Angular code with the SAME TypeScript the project builds with
    // (5.5.4, per package.json). Without this the editor falls back to its own
    // bundled compiler, which can be several major versions ahead and reports
    // errors the real build never produces.
    //
    // VS Code will not load a workspace compiler silently. After this lands, run
    // "TypeScript: Select TypeScript Version" once and choose "Use Workspace
    // Version"; the prompt setting below offers that automatically.
    "typescript.tsdk": "frontend/tracker-ui/node_modules/typescript/lib",
    "typescript.enablePromptUseWorkspaceTsdk": true,
    "java.configuration.updateBuildConfiguration": "interactive",

    // Tell the Java language server which JDKs exist on this machine.
    //
    // The pom sets <java.version>25</java.version>, so the compiler is asked for
    // "--release 25". The language server keeps its OWN registry of JDKs, entirely
    // separate from JAVA_HOME, and without an entry here it reports
    // "release 25 is not found in the system" even though `mvnw clean package`
    // builds perfectly from the command line.
    //
    // The "name" values are Eclipse execution environments and must be spelled
    // exactly like this; JavaSE-1.8 would be the odd one out if it were listed.
    //
    // ONLY LIST JDKs THAT ACTUALLY EXIST ON THIS MACHINE.
    // Every entry here is validated on startup, and one pointing at a missing
    // folder produces a blocking "Invalid runtime for JavaSE-nn" notification -
    // even when the project does not target that version. This file previously
    // carried four entries copied from a different machine (a "Developer.03"
    // user profile, plus a JDK 11 and a JDK 8 that were never installed here),
    // and raised one error per absent path. The build was never affected: the
    // Maven Wrapper reads JAVA_HOME and knows nothing about this registry.
    //
    // THIS PATH IS MACHINE-SPECIFIC AND THIS FILE IS COMMITTED TO GIT.
    // That combination has now broken the editor twice, once in each direction:
    // whoever fixes it for their own machine commits a path the other machine
    // does not have, and the next pull hands the error to the other developer.
    // The build is never affected either way - the Maven Wrapper reads JAVA_HOME
    // and knows nothing about this registry.
    //
    // A literal path is required. ${env:JAVA_HOME} was tried here and does NOT
    // work: VS Code does not expand variables in this setting, and the language
    // server reported the placeholder back verbatim -
    // "Invalid runtime for JavaSE-25 ... (${env:JAVA_HOME})".
    //
    // So correct the path to your own JDK 25 if you clone this project -
    // `echo $env:JAVA_HOME` gives it - rather than adding entries for JDKs this
    // project has no use for.
    //
    // THE DURABLE FIX IS TO STOP SHARING THIS BLOCK. Moving
    // java.configuration.runtimes into your VS Code USER settings
    // (%APPDATA%\Code\User\settings.json) keeps the machine-specific part out of
    // git entirely, while this file keeps the settings that are identical
    // everywhere. See docs/error-fixes/invalid-runtime-for-javase.md.
    "java.configuration.runtimes": [
        {
            "name": "JavaSE-25",
            "path": "C:\\Users\\Developer.03\\Java\\jdk-25.0.4+7",
            "default": true
        }
    ]
}